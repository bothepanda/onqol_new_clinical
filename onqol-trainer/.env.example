# Server-side provider credential. Never expose it through VITE_* variables.
OPENAI_API_KEY=

# Exact protected deployment origin, for example https://pilot.onqol.kz
ONQOL_MAIN_ALLOWED_ORIGIN=

# Separate internal pilot access code, entered by the learner in the start screen.
ONQOL_MAIN_ACCESS_TOKEN=

# Optional server-side model overrides.
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_SIMULATOR_MODEL=gpt-5.6-terra
OPENAI_MENTOR_MODEL=gpt-5.6-luna

# Local/internal-only multi-page test build. When confirmed, the build also
# emits /faculty.html with corpus review controls and hidden-case inspection.
# It does not approve draft clinical rules or enable learner scoring.
VITE_ONQOL_INTERNAL_FULL_TEST=

# Local-only learner surface that bypasses clinical review/application gates,
# exposes APP-005, and enables explicitly unvalidated numeric scoring. Never use
# this flag for a pilot or production build.
VITE_ONQOL_FULL_CLINICAL_TEST=

# Production release confirmations. The Vercel build remains NO-GO until each
# owner-controlled gate is explicitly recorded; values are never sent to the browser.
ONQOL_PROVIDER_KEY_ROTATED=
ONQOL_HOSTING_AUTH_CONFIRMED=
ONQOL_CLINICAL_SIGNOFF_ID=
ONQOL_RU_LANGUAGE_REVIEW_ID=
ONQOL_RESOURCE_PROFILE_REVIEW_ID=
ONQOL_PRIVACY_OWNER_APPROVAL_ID=

# Keep empty. Setting this to "confirmed" additionally requires complete,
# reviewed Kazakh learner-facing copy; the current UI keeps KZ disabled.
ONQOL_ENABLE_KK=
