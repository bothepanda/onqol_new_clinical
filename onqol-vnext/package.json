{
  "name": "onqol-vnext",
  "private": true,
  "version": "0.1.0-vnext",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "content:build": "node scripts/buildContentIndex.mjs",
    "content:check": "node scripts/buildContentIndex.mjs --check",
    "wave2:corpus": "node scripts/runWave2ShadowCorpus.mjs",
    "wave21:live": "node scripts/runWave21LiveShadow.mjs",
    "wave22:development": "node scripts/runWave22LiveEvaluation.mjs --suite development",
    "wave22:holdout": "node scripts/runWave22LiveEvaluation.mjs --suite holdout",
    "wave22:safety": "node scripts/runWave22LiveEvaluation.mjs --suite safety",
    "wave22:live": "node scripts/runWave22LiveEvaluation.mjs --suite all",
    "wave23:development": "node scripts/runWave23Bakeoff.mjs --suite development",
    "wave23:freeze": "node scripts/freezeWave23.mjs",
    "wave23:freeze:check": "node scripts/freezeWave23.mjs --check",
    "wave23:holdout": "node scripts/runWave23Bakeoff.mjs --suite holdout",
    "wave23:safety": "node scripts/runWave23Bakeoff.mjs --suite safety",
    "wave23:bakeoff": "node scripts/runWave23Bakeoff.mjs --suite all",
    "test": "npm run content:build && node --test \"src/**/*.test.js\" \"scripts/**/*.test.js\"",
    "test:e2e": "playwright test",
    "hybrid:smoke": "node scripts/smokeHybridInterpreter.mjs",
    "pack:safe": "node scripts/packSafe.mjs",
    "verify": "npm run content:check && npm test && npm run wave2:corpus && npm run lint && npm run build"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
