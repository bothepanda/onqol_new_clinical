{
  "name": "onqol-vnext",
  "private": true,
  "version": "0.1.0-vnext",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "content:build": "node scripts/buildContentIndex.mjs",
    "content:check": "node scripts/buildContentIndex.mjs --check",
    "test": "npm run content:build && node --test \"src/**/*.test.js\"",
    "pack:safe": "node scripts/packSafe.mjs",
    "verify": "npm run content:check && npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
