{
  "name": "onqol-vnext",
  "private": true,
  "version": "0.1.0-vnext",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "npm run content:build && vite",
    "dev:flexible": "ONQOL_FLEXIBLE_PATIENT=true VITE_ONQOL_FLEXIBLE_PATIENT=true VITE_ONQOL_PILOT=false npm run dev -- --host 127.0.0.1",
    "build": "npm run content:build && vite build",
    "preview": "vite preview",
    "build:pilot": "VITE_ONQOL_INTERPRETER=deterministic VITE_ONQOL_PILOT=true npm run build",
    "start:pilot": "node server/pilotServer.mjs",
    "build:hybrid": "VITE_ONQOL_INTERPRETER=hybrid VITE_ONQOL_PILOT=true npm run build",
    "start:hybrid": "node --env-file-if-exists=.env.local server/pilotServer.mjs",
    "lint": "eslint .",
    "content:build": "node scripts/buildContentIndex.mjs",
    "content:check": "node scripts/buildContentIndex.mjs --check",
    "wave2:corpus": "node scripts/runWave2ShadowCorpus.mjs",
    "wave21:live": "node scripts/runWave21LiveShadow.mjs",
    "wave22:development": "node scripts/runWave22LiveEvaluation.mjs --suite development",
    "wave22:holdout": "node scripts/runWave22LiveEvaluation.mjs --suite holdout",
    "wave22:safety": "node scripts/runWave22LiveEvaluation.mjs --suite safety",
    "wave22:live": "node scripts/runWave22LiveEvaluation.mjs --suite all",
    "wave23:development": "node scripts/runWave23Bakeoff.mjs --suite development",
    "wave23:freeze": "node scripts/freezeWave23.mjs",
    "wave23:freeze:check": "node scripts/freezeWave23.mjs --check",
    "wave23:holdout": "node scripts/runWave23Bakeoff.mjs --suite holdout",
    "wave23:safety": "node scripts/runWave23Bakeoff.mjs --suite safety",
    "wave23:bakeoff": "node scripts/runWave23Bakeoff.mjs --suite all",
    "test": "npm run content:build && node --test \"src/**/*.test.js\" \"scripts/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:e2e:flexible": "playwright test --config playwright.flexible.config.js",
    "test:e2e:hybrid": "playwright test --config playwright.hybrid.config.js",
    "hybrid:smoke": "node scripts/smokeHybridInterpreter.mjs",
    "stage2:prepare": "node scripts/prepareStage2.mjs",
    "stage2:development": "node scripts/runStage2Corpus.mjs --suite development",
    "stage2:holdout": "node scripts/runStage2Corpus.mjs --suite holdout",
    "stage2:acceptance": "node scripts/stage2Acceptance.mjs",
    "stage2:broken-key": "node scripts/stage2Acceptance.mjs --broken-key",
    "stage2:host-check": "node scripts/checkStage2Host.mjs",
    "pack:safe": "node scripts/packSafe.mjs",
    "governance:check": "node scripts/evidenceGovernance.mjs",
    "verify": "npm run content:check && npm run governance:check && npm test && npm run wave2:corpus && npm run lint && npm run build",
    "dev:mentor": "ONQOL_EXPERIMENTAL_MENTOR=true VITE_ONQOL_PILOT=false VITE_ONQOL_MENTOR=experimental npm run dev -- --host 127.0.0.1",
    "test:e2e:mentor": "playwright test --config playwright.mentor.config.js",
    "test:e2e:semantic": "playwright test --config playwright.semantic.config.js",
    "dev:semantic": "VITE_ONQOL_INTERPRETER=semantic_first npm run dev:mentor",
    "semantic:smoke": "node scripts/smokeSemanticFirst.mjs --live"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
